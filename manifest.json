{
  "manifest_version": 3,
  "name": "golinks",
  "homepage_url": "https://github.com/bsara/golinks",
  "version": "1.0.0",
  "description": "golinks in your browser",
  "icons": {
    "16": "images/icon.png",
    "32": "images/icon.png",
    "48": "images/icon.png",
    "128": "images/icon.png"
  },
  "background": {
    "service_worker": "main.js",
    "type": "module"
  },
  "permissions": [
    "alarms",
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "options_page": "./pages/index.html",
  "omnibox": {
    "keyword": "go"
  }
}