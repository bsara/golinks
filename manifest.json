{
  "manifest_version": 3,
  "name": "golinks+",
  "homepage_url": "https://github.com/bsara/golinks-plus",
  "version": "1.0.0",
  "description": "golinks in your browser",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "background": {
    "service_worker": "main.js",
    "type": "module"
  },
  "permissions": [
    "alarms",
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "storage": {
    "managed_schema": "managed_schema.json"
  },
  "options_page": "./pages/index.html",
  "omnibox": {
    "keyword": "go"
  }
}